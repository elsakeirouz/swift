// RUN: %empty-directory(%t)
// RUN: split-file %s %t
// RUN: %target-sil-opt -sil-print-types -enable-sil-opaque-values -module-name Swift -sil-verify-all %t/valid.sil | %FileCheck %s --check-prefix=VALID
// RUN: not --crash %target-sil-opt -enable-sil-opaque-values -module-name Swift %t/copy-operand.sil 2>&1 | %FileCheck %s --check-prefix=COPY
// RUN: not --crash %target-sil-opt -module-name Swift %t/not-opaque-values.sil 2>&1 | %FileCheck %s --check-prefix=NOT-OPAQUE-VALUES
// RUN: not %target-sil-opt -enable-sil-opaque-values -module-name Swift %t/address-operand.sil 2>&1 | %FileCheck %s --check-prefix=ADDRESS-OPERAND

// REQUIRES: asserts

// value_to_address yields the address of an opaque value's storage. Its
// operand must be a variable: an indirect argument, a [var_decl] move_value or
// begin_borrow, a borrow accessor result, or a guaranteed coroutine yield.

//--- valid.sil
import Builtin

sil_stage raw

struct Box<T> {
  var t: T
}

// VALID-LABEL: sil {{.*}}@indirect_argument :
// VALID:         value_to_address %0 : $T
sil [ossa] @indirect_argument : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = value_to_address %0 : $T
  %2 = address_to_pointer %1 : $*T to $Builtin.RawPointer
  return %2 : $Builtin.RawPointer
}

// VALID-LABEL: sil {{.*}}@move_value_variable :
// VALID:         [[VAR:%.*]] = move_value [var_decl] %1 : $T
// VALID:         value_to_address [[VAR]] : $T
sil [ossa] @move_value_variable : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = copy_value %0 : $T
  %2 = move_value [var_decl] %1 : $T
  %3 = value_to_address %2 : $T
  %4 = address_to_pointer %3 : $*T to $Builtin.RawPointer
  destroy_value %2 : $T
  return %4 : $Builtin.RawPointer
}

// VALID-LABEL: sil {{.*}}@begin_borrow_variable :
// VALID:         [[VAR:%.*]] = begin_borrow [var_decl] %0 : $T
// VALID:         value_to_address [[VAR]] : $T
sil [ossa] @begin_borrow_variable : $@convention(thin) <T> (@in T) -> Builtin.RawPointer {
bb0(%0 : @owned $T):
  %1 = begin_borrow [var_decl] %0 : $T
  %2 = value_to_address %1 : $T
  %3 = address_to_pointer %2 : $*T to $Builtin.RawPointer
  end_borrow %1 : $T
  destroy_value %0 : $T
  return %3 : $Builtin.RawPointer
}

// The operand may be a plain borrow of a variable.
//
// VALID-LABEL: sil {{.*}}@borrow_of_variable :
// VALID:         [[BORROW:%.*]] = begin_borrow %2 : $T
// VALID:         value_to_address [[BORROW]] : $T
sil [ossa] @borrow_of_variable : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = copy_value %0 : $T
  %2 = move_value [var_decl] %1 : $T
  %3 = begin_borrow %2 : $T
  %4 = value_to_address %3 : $T
  %5 = address_to_pointer %4 : $*T to $Builtin.RawPointer
  end_borrow %3 : $T
  destroy_value %2 : $T
  return %5 : $Builtin.RawPointer
}

sil [ossa] @borrow_accessor : $@convention(method) <T> (@in_guaranteed Box<T>) -> @guaranteed_address T {
bb0(%0 : @guaranteed $Box<T>):
  %1 = struct_extract %0 : $Box<T>, #Box.t
  return %1 : $T
}

// VALID-LABEL: sil {{.*}}@borrow_accessor_result :
// VALID:         [[RESULT:%.*]] = apply {{%.*}}<T>(%0) : {{.*}} -> @guaranteed_address τ_0_0
// VALID:         value_to_address [[RESULT]] : $T
sil [ossa] @borrow_accessor_result : $@convention(thin) <T> (@in_guaranteed Box<T>) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $Box<T>):
  %1 = function_ref @borrow_accessor : $@convention(method) <T> (@in_guaranteed Box<T>) -> @guaranteed_address T
  %2 = apply %1<T>(%0) : $@convention(method) <T> (@in_guaranteed Box<T>) -> @guaranteed_address T
  %3 = value_to_address %2 : $T
  %4 = address_to_pointer %3 : $*T to $Builtin.RawPointer
  return %4 : $Builtin.RawPointer
}

sil [ossa] @yielder : $@yield_once @convention(thin) <T> (@in_guaranteed T) -> @yields @in_guaranteed T

// VALID-LABEL: sil {{.*}}@coroutine_yield :
// VALID:         ([[YIELD:%.*]], [[TOKEN:%.*]]) = begin_apply
// VALID:         value_to_address [[YIELD]] : $T
sil [ossa] @coroutine_yield : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = function_ref @yielder : $@yield_once @convention(thin) <T> (@in_guaranteed T) -> @yields @in_guaranteed T
  (%2, %3) = begin_apply %1<T>(%0) : $@yield_once @convention(thin) <T> (@in_guaranteed T) -> @yields @in_guaranteed T
  %4 = value_to_address %2 : $T
  %5 = address_to_pointer %4 : $*T to $Builtin.RawPointer
  end_apply %3 as $()
  return %5 : $Builtin.RawPointer
}

//--- copy-operand.sil
import Builtin

sil_stage raw

// A temporary has no stable address.
// COPY: value_to_address operand must be an indirect argument, a [var_decl] move_value or begin_borrow, a borrow accessor result, or a guaranteed coroutine yield
sil [ossa] @copy_operand : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = copy_value %0 : $T
  %2 = value_to_address %1 : $T
  %3 = address_to_pointer %2 : $*T to $Builtin.RawPointer
  destroy_value %1 : $T
  return %3 : $Builtin.RawPointer
}

//--- not-opaque-values.sil
import Builtin

sil_stage raw

// Without opaque values, address-only values have addresses already.
// NOT-OPAQUE-VALUES: value_to_address is only valid in opaque values
sil [ossa] @not_opaque_values : $@convention(thin) <T> () -> Builtin.RawPointer {
bb0:
  %0 = value_to_address undef : $T
  %1 = address_to_pointer %0 : $*T to $Builtin.RawPointer
  return %1 : $Builtin.RawPointer
}

//--- address-operand.sil
import Builtin

sil_stage raw

// ADDRESS-OPERAND: operand of 'value_to_address' must have object type
sil [ossa] @address_operand : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = alloc_stack $T
  %2 = value_to_address %1 : $*T
  %3 = address_to_pointer %2 : $*T to $Builtin.RawPointer
  dealloc_stack %1 : $*T
  return %3 : $Builtin.RawPointer
}
