// RUN: %target-sil-opt -sil-print-types -address-lowering -enable-sil-opaque-values -module-name Swift -sil-verify-all %s | %FileCheck %s
//
// The module name must be Swift so that declarations like Error are parsed as the correct loadable type.

// value_to_address is the address of its operand's storage. AddressLowering
// assigns that storage, so the instruction resolves to the same address as the
// operand's other uses.

import Builtin

sil_stage raw

struct Box<T> {
  var t: T
}

// The address of an indirect argument is the address the caller passed.
//
// CHECK-LABEL: sil [ossa] @indirect_argument : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
// CHECK: bb0(%0 : $*T):
// CHECK-NEXT:    [[PTR:%.*]] = address_to_pointer %0 : $*T to $Builtin.RawPointer
// CHECK-NEXT:    return [[PTR]] : $Builtin.RawPointer
// CHECK-LABEL: } // end sil function 'indirect_argument'
sil [ossa] @indirect_argument : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = value_to_address %0 : $T
  %2 = address_to_pointer %1 : $*T to $Builtin.RawPointer
  return %2 : $Builtin.RawPointer
}

// A [var_decl] move_value uses the storage of the value that it moves. Here that
// is the copy's own stack slot.
//
// CHECK-LABEL: sil [ossa] @move_value_variable : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
// CHECK: bb0(%0 : $*T):
// CHECK:         [[SLOT:%.*]] = alloc_stack $T
// CHECK-NEXT:    copy_addr %0 to [init] [[SLOT]] : $*T
// CHECK-NEXT:    [[PTR:%.*]] = address_to_pointer [[SLOT]] : $*T to $Builtin.RawPointer
// CHECK-NEXT:    destroy_addr [[SLOT]] : $*T
// CHECK-NEXT:    dealloc_stack [[SLOT]] : $*T
// CHECK-NEXT:    return [[PTR]] : $Builtin.RawPointer
// CHECK-LABEL: } // end sil function 'move_value_variable'
sil [ossa] @move_value_variable : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = copy_value %0 : $T
  %2 = move_value [var_decl] %1 : $T
  %3 = value_to_address %2 : $T
  %4 = address_to_pointer %3 : $*T to $Builtin.RawPointer
  destroy_value %2 : $T
  return %4 : $Builtin.RawPointer
}

// A [var_decl] begin_borrow uses the storage of the value that it borrows. Here
// that is the owned argument's address.
//
// CHECK-LABEL: sil [ossa] @begin_borrow_variable : $@convention(thin) <T> (@in T) -> Builtin.RawPointer {
// CHECK: bb0(%0 : $*T):
// CHECK-NEXT:    [[PTR:%.*]] = address_to_pointer %0 : $*T to $Builtin.RawPointer
// CHECK-NEXT:    destroy_addr %0 : $*T
// CHECK-NEXT:    return [[PTR]] : $Builtin.RawPointer
// CHECK-LABEL: } // end sil function 'begin_borrow_variable'
sil [ossa] @begin_borrow_variable : $@convention(thin) <T> (@in T) -> Builtin.RawPointer {
bb0(%0 : @owned $T):
  %1 = begin_borrow [var_decl] %0 : $T
  %2 = value_to_address %1 : $T
  %3 = address_to_pointer %2 : $*T to $Builtin.RawPointer
  end_borrow %1 : $T
  destroy_value %0 : $T
  return %3 : $Builtin.RawPointer
}

// A plain borrow of a variable shares the variable's storage.
//
// CHECK-LABEL: sil [ossa] @borrow_of_variable : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
// CHECK: bb0(%0 : $*T):
// CHECK:         [[SLOT:%.*]] = alloc_stack $T
// CHECK-NEXT:    copy_addr %0 to [init] [[SLOT]] : $*T
// CHECK-NEXT:    [[PTR:%.*]] = address_to_pointer [[SLOT]] : $*T to $Builtin.RawPointer
// CHECK-NEXT:    destroy_addr [[SLOT]] : $*T
// CHECK-NEXT:    dealloc_stack [[SLOT]] : $*T
// CHECK-NEXT:    return [[PTR]] : $Builtin.RawPointer
// CHECK-LABEL: } // end sil function 'borrow_of_variable'
sil [ossa] @borrow_of_variable : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = copy_value %0 : $T
  %2 = move_value [var_decl] %1 : $T
  %3 = begin_borrow %2 : $T
  %4 = value_to_address %3 : $T
  %5 = address_to_pointer %4 : $*T to $Builtin.RawPointer
  end_borrow %3 : $T
  destroy_value %2 : $T
  return %5 : $Builtin.RawPointer
}

sil [ossa] @borrow_accessor : $@convention(method) <T> (@in_guaranteed Box<T>) -> @guaranteed_address T {
bb0(%0 : @guaranteed $Box<T>):
  %1 = struct_extract %0 : $Box<T>, #Box.t
  return %1 : $T
}

// A borrow accessor returns the address of its result, so the caller uses that
// address directly rather than a copy.
//
// CHECK-LABEL: sil [ossa] @borrow_accessor_result : $@convention(thin) <T> (@in_guaranteed Box<T>) -> Builtin.RawPointer {
// CHECK: bb0(%0 : $*Box<T>):
// CHECK-NOT:     alloc_stack
// CHECK:         [[FN:%.*]] = function_ref @borrow_accessor
// CHECK-NEXT:    [[BORROWED:%.*]] = apply [[FN]]<T>(%0) : $@convention(method) <τ_0_0> (@in_guaranteed Box<τ_0_0>) -> @guaranteed_address τ_0_0
// CHECK-NEXT:    [[PTR:%.*]] = address_to_pointer [[BORROWED]] : $*T to $Builtin.RawPointer
// CHECK-NEXT:    return [[PTR]] : $Builtin.RawPointer
// CHECK-LABEL: } // end sil function 'borrow_accessor_result'
sil [ossa] @borrow_accessor_result : $@convention(thin) <T> (@in_guaranteed Box<T>) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $Box<T>):
  %1 = function_ref @borrow_accessor : $@convention(method) <T> (@in_guaranteed Box<T>) -> @guaranteed_address T
  %2 = apply %1<T>(%0) : $@convention(method) <T> (@in_guaranteed Box<T>) -> @guaranteed_address T
  %3 = value_to_address %2 : $T
  %4 = address_to_pointer %3 : $*T to $Builtin.RawPointer
  return %4 : $Builtin.RawPointer
}

sil [ossa] @yielder : $@yield_once @convention(thin) <T> (@in_guaranteed T) -> @yields @in_guaranteed T

// A guaranteed yield is the address the coroutine yielded, so it is not copied
// into a local slot.
//
// CHECK-LABEL: sil [ossa] @coroutine_yield : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
// CHECK: bb0(%0 : $*T):
// CHECK-NOT:     alloc_stack
// CHECK:         ([[YIELD:%.*]], [[TOKEN:%.*]]) = begin_apply {{%.*}}<T>(%0)
// CHECK-NEXT:    [[PTR:%.*]] = address_to_pointer [[YIELD]] : $*T to $Builtin.RawPointer
// CHECK-NEXT:    end_apply [[TOKEN]] as $()
// CHECK-NEXT:    return [[PTR]] : $Builtin.RawPointer
// CHECK-LABEL: } // end sil function 'coroutine_yield'
sil [ossa] @coroutine_yield : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = function_ref @yielder : $@yield_once @convention(thin) <T> (@in_guaranteed T) -> @yields @in_guaranteed T
  (%2, %3) = begin_apply %1<T>(%0) : $@yield_once @convention(thin) <T> (@in_guaranteed T) -> @yields @in_guaranteed T
  %4 = value_to_address %2 : $T
  %5 = address_to_pointer %4 : $*T to $Builtin.RawPointer
  end_apply %3 as $()
  return %5 : $Builtin.RawPointer
}
