// RUN: %target-sil-opt -sil-print-types -address-lowering -enable-sil-opaque-values -emit-sorted-sil -module-name Swift -sil-verify-all %s | %FileCheck %s
//
// The module name must be Swift so that declarations like Error are parsed as the correct loadable type.

import Builtin

sil_stage raw

typealias Int = Builtin.Int64

protocol Error {}

// A callee that has more than one direct result and a generic typed error,
// which is returned indirectly.
sil [ossa] @multiResultThrowing : $@convention(thin) <E where E : Error> () -> (Int, Int, @error_indirect E)

// The results of a `try_apply` with more than one direct result are the normal
// block's tuple argument, which has no storage of its own. The error block's
// argument is the error itself, not one of those results, so it must be lowered
// like any other opaque value.
// CHECK-LABEL: sil [ossa] @caller : $@convention(thin) <E where E : Error> () -> (Builtin.Int64, @error_indirect E) {
// CHECK:       bb0([[ERROR_OUT:%[^,]+]] : $*E):
// CHECK:         [[ERROR_BUF:%[^,]+]] = alloc_stack $E
// CHECK:         try_apply {{%[^,]+}}<E>([[ERROR_BUF]]) : $@convention(thin) <τ_0_0 where τ_0_0 : Error> () -> (Builtin.Int64, Builtin.Int64, @error_indirect τ_0_0), normal bb2, error bb1
//
// CHECK:       bb1:
// CHECK:         [[COPY:%[^,]+]] = alloc_stack $E
// CHECK:         copy_addr [[ERROR_BUF]] to [init] [[COPY]] : $*E
// CHECK:         destroy_addr [[ERROR_BUF]] : $*E
// CHECK:         copy_addr [take] [[COPY]] to [init] [[ERROR_OUT]] : $*E
// CHECK:         throw_addr
//
// CHECK:       bb2({{%[^,]+}} : $(Builtin.Int64, Builtin.Int64)):
// CHECK:         destructure_tuple
// CHECK-LABEL: } // end sil function 'caller'
sil [ossa] @caller : $@convention(thin) <E where E : Error> () -> (Int, @error_indirect E) {
bb0:
  %callee = function_ref @multiResultThrowing : $@convention(thin) <τ_0_0 where τ_0_0 : Error> () -> (Int, Int, @error_indirect τ_0_0)
  try_apply %callee<E>() : $@convention(thin) <τ_0_0 where τ_0_0 : Error> () -> (Int, Int, @error_indirect τ_0_0), normal bb1, error bb2

bb1(%results : $(Int, Int)):
  (%first, %second) = destructure_tuple %results : $(Int, Int)
  return %first : $Int

bb2(%error : @owned $E):
  %copy = copy_value %error : $E
  destroy_value %error : $E
  throw %copy : $E
}
